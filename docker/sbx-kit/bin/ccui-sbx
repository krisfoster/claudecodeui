#!/usr/bin/env bash
# ccui-sbx — launch a `claude` Docker Sandbox for this claudecodeui checkout
# with the claudecodeui-dev kit (docker/sbx-kit) attached and the dev
# server's ports published.
#
# It is a thin wrapper around `sbx run claude` — every argument you pass is
# forwarded to `sbx run` untouched, so all of `sbx run`'s normal flags and
# positional args (PATH, --env, --clone, -- AGENT_ARGS, etc.) work exactly
# as documented in `sbx run --help`.
#
# By default the sandbox is created headless (`--detached`): the claude
# TUI never takes over your terminal, so the actual published ports stay
# visible. A summary with the resolved URLs and follow-up commands prints
# once the sandbox is up. Pass CCUI_SBX_ATTACH=1 to get the old behavior
# (attach to the interactive claude session immediately).
#
# Usage:
#   ccui-sbx [PATH] [EXTRA_WORKSPACE] [sbx run flags...] [-- AGENT_ARGS...]
#
# Examples:
#   ccui-sbx                          # mount $PWD, headless, prints the URLs
#   ccui-sbx ~/repos/claudecodeui
#   ccui-sbx . --name ccui-dev
#   ccui-sbx . ~/claude_work/kb       # also mounts a second workspace,
#                                     # auto-registered as the default project
#   CCUI_SBX_ATTACH=1 ccui-sbx .      # attach to claude interactively instead
#
# Env overrides:
#   CCUI_SBX_SERVER_PORT   host port published to the API/web UI (container :3001). Default 3001.
#   CCUI_SBX_CLIENT_PORT   host port published to the Vite client (container :5173). Default 5173.
#   CCUI_SBX_NO_KIT=1      skip attaching the claudecodeui-dev kit (plain claude sandbox + ports)
#   CCUI_SBX_ATTACH=1      attach to the interactive claude session instead of running headless
#   CCUI_SBX_NO_OPEN=1     don't auto-open the client URL in the default browser once it's up
#
# In headless mode, once the sandbox is up this also auto-opens the Vite
# client URL in your default browser (macOS `open` / Linux `xdg-open` or
# `wslview`; a no-op if none of those exist). If a fresh admin account was
# just created, the opened URL carries ?username=&password= so the login
# form prefills itself (then immediately scrubs the URL) — the password is
# also copied to your clipboard (pbcopy/wl-copy/xclip/xsel) as a fallback.
#
# A second bare positional path (e.g. `ccui-sbx . ~/claude_work/kb`) is
# mounted as an extra workspace AND passed to the sandbox as
# CLOUDCLI_DEFAULT_PROJECT_PATH, so the server registers it as a project
# automatically instead of rejecting it if you tried adding it by hand —
# `sbx` always mounts every workspace at its exact host path (never
# remapped under /home/agent), which the app's default workspace-root
# check would otherwise reject.
#
# The kit is resolved relative to this script's own real location, so it
# always uses the kit from the checkout this script was installed from,
# regardless of what PATH you launch or what directory you run it from.
#
# If a default/override host port is already bound by something else, this
# script does not fail the whole launch: it drops the host-side port number
# and lets sbx allocate an ephemeral one instead, printing a warning. The
# headless summary below reports whatever port actually got used.

set -euo pipefail

usage() {
  sed -n '2,49p' "$0" | sed 's/^# \{0,1\}//'
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
  echo
  echo "── sbx run --help ──"
  exec sbx run --help
fi

resolve_self() {
  local src="${BASH_SOURCE[0]}"
  while [ -h "$src" ]; do
    local dir
    dir="$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)"
    src="$(readlink "$src")"
    case "$src" in
      /*) ;;
      *) src="$dir/$src" ;;
    esac
  done
  cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd
}

if ! command -v sbx >/dev/null 2>&1; then
  echo "ccui-sbx: 'sbx' CLI not found. Install Docker Sandboxes: https://docs.docker.com/ai/sandboxes/get-started/" >&2
  exit 1
fi

SCRIPT_DIR="$(resolve_self)"
KIT_DIR="$(cd "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd)"

SERVER_PORT="${CCUI_SBX_SERVER_PORT:-3001}"
CLIENT_PORT="${CCUI_SBX_CLIENT_PORT:-5173}"

# Is something already listening on this host port? Prefer lsof (fast,
# no network round trip); fall back to a bash TCP connect if lsof is
# unavailable. Best-effort: on any doubt, assume free so we don't block
# the happy path over a detection failure.
port_in_use() {
  local port="$1"
  if command -v lsof >/dev/null 2>&1; then
    lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1
    return $?
  fi
  ( : <"/dev/tcp/127.0.0.1/$port" ) >/dev/null 2>&1
}

# Best-effort cross-platform "open this URL in the default browser."
# Silently does nothing if no known opener exists (e.g. a headless CI box)
# or if CCUI_SBX_NO_OPEN=1 is set, since this is a convenience, not a
# requirement — the URL is always printed regardless.
open_url() {
  local url="$1"
  if [ "${CCUI_SBX_NO_OPEN:-0}" = "1" ]; then
    return 0
  fi
  if command -v open >/dev/null 2>&1; then
    open "$url" >/dev/null 2>&1 || true
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url" >/dev/null 2>&1 || true
  elif command -v wslview >/dev/null 2>&1; then
    wslview "$url" >/dev/null 2>&1 || true
  fi
}

# Best-effort "copy this to the system clipboard" — macOS pbcopy, or
# whichever Linux clipboard tool happens to be installed. Silently does
# nothing if none is found; the password is always printed regardless.
copy_to_clipboard() {
  local text="$1"
  if command -v pbcopy >/dev/null 2>&1; then
    printf '%s' "$text" | pbcopy
  elif command -v wl-copy >/dev/null 2>&1; then
    printf '%s' "$text" | wl-copy
  elif command -v xclip >/dev/null 2>&1; then
    printf '%s' "$text" | xclip -selection clipboard
  elif command -v xsel >/dev/null 2>&1; then
    printf '%s' "$text" | xsel --clipboard --input
  fi
}

# Percent-encode a string for use in a URL query value. Prefers jq (already
# a soft dependency below, for parsing `sbx ports --json`); falls back to a
# pure-bash loop so this still works without jq.
urlencode() {
  local s="$1"
  if command -v jq >/dev/null 2>&1; then
    jq -rn --arg v "$s" '$v|@uri'
    return
  fi
  local out="" c i
  for (( i=0; i<${#s}; i++ )); do
    c="${s:i:1}"
    case "$c" in
      [a-zA-Z0-9.~_-]) out+="$c" ;;
      *) out+="$(printf '%%%02X' "'$c")" ;;
    esac
  done
  printf '%s' "$out"
}

# Build a --publish value for a given desired host port + container port.
# Falls back to an ephemeral host port (bare container port, no HOST_PORT)
# when the desired host port is already taken, instead of failing outright.
publish_spec() {
  local host_port="$1" container_port="$2" label="$3"
  if port_in_use "$host_port"; then
    echo "ccui-sbx: warning: host port $host_port ($label) is already in use — letting sbx pick an ephemeral port instead." >&2
    printf '%s' "$container_port"
  else
    printf '%s:%s' "$host_port" "$container_port"
  fi
}

server_publish="$(publish_spec "$SERVER_PORT" 3001 "API/web UI")"
client_publish="$(publish_spec "$CLIENT_PORT" 5173 "Vite client")"

kit_flags=()
if [ "${CCUI_SBX_NO_KIT:-0}" != "1" ]; then
  if [ -f "$KIT_DIR/spec.yaml" ]; then
    kit_flags=(--kit "$KIT_DIR")
  else
    echo "ccui-sbx: warning: no kit found at $KIT_DIR — launching a plain claude sandbox" >&2
  fi
fi

# Respect an explicit --name/--name=X the caller already passed (scanning
# only up to a literal `--`, since anything after that belongs to the
# agent, not to sbx run). Otherwise pick a deterministic default of our
# own so headless mode always knows which sandbox to query afterwards.
sbx_name=""
take_next=0
for arg in "$@"; do
  if [ "$take_next" = 1 ]; then
    sbx_name="$arg"
    break
  fi
  case "$arg" in
    --) break ;;
    --name) take_next=1 ;;
    --name=*) sbx_name="${arg#--name=}"; break ;;
  esac
done

name_flags=()
if [ -z "$sbx_name" ]; then
  # basename alone collides for two different checkouts that happen to share
  # a directory name (e.g. ~/repos/claudecodeui and ~/other/claudecodeui) —
  # fold in a short checksum of the full path so each gets a distinct,
  # still-deterministic default name.
  path_hash="$(printf '%s' "$PWD" | cksum | cut -d' ' -f1)"
  sbx_name="ccui-$(basename "$PWD")-$path_hash"
  name_flags=(--name "$sbx_name")
fi

# Positional workspace paths precede any flag (matches the documented
# `ccui-sbx [PATH] [EXTRA_WORKSPACE] [sbx run flags...]` usage) — collect
# the leading run of bare args, stripping a trailing `:ro`. The first is
# the primary checkout; a second one is an extra mounted workspace that
# becomes the sandbox's default project (see spec.yaml's WORKSPACES_ROOT
# comment for why it would otherwise be rejected).
workspace_paths=()
for arg in "$@"; do
  case "$arg" in
    --|-*) break ;;
    *) workspace_paths+=("${arg%:ro}") ;;
  esac
done

env_flags=()
if [ "${#workspace_paths[@]}" -ge 2 ] && [ -d "${workspace_paths[1]}" ]; then
  default_project_path="$(cd "${workspace_paths[1]}" >/dev/null 2>&1 && pwd)"
  env_flags=(--env "CLOUDCLI_DEFAULT_PROJECT_PATH=$default_project_path")
fi

if [ "${CCUI_SBX_ATTACH:-0}" = "1" ]; then
  exec sbx run claude \
    "${kit_flags[@]}" \
    --publish "$server_publish" \
    --publish "$client_publish" \
    "${name_flags[@]}" \
    "${env_flags[@]}" \
    "$@"
fi

sbx run claude \
  "${kit_flags[@]}" \
  --publish "$server_publish" \
  --publish "$client_publish" \
  "${name_flags[@]}" \
  "${env_flags[@]}" \
  --detached \
  "$@"

echo
echo "── ccui-sbx: '$sbx_name' is running headless ──"

server_url=""
client_url=""
ports_json="$(sbx ports "$sbx_name" --json 2>/dev/null || true)"
if command -v jq >/dev/null 2>&1 && [ -n "$ports_json" ]; then
  server_url="$(printf '%s' "$ports_json" | jq -r '.[] | select(.sandbox_port==3001) | "http://\(.host_ip):\(.host_port)"' 2>/dev/null | head -1)"
  client_url="$(printf '%s' "$ports_json" | jq -r '.[] | select(.sandbox_port==5173) | "http://\(.host_ip):\(.host_port)"' 2>/dev/null | head -1)"
fi

if [ -n "$server_url" ]; then
  echo "  Web UI / API:  $server_url"
fi
if [ -n "$client_url" ]; then
  echo "  Vite (HMR):    $client_url"
fi
if [ -z "$server_url$client_url" ]; then
  echo "  (couldn't resolve the published ports automatically — run: sbx ports $sbx_name)"
fi

# The kit sets CLOUDCLI_AUTO_CREATE_ADMIN=true, so a fresh sandbox's server
# prints a one-time "CLOUDCLI_ADMIN_PASSWORD=..." line to its own stdout —
# but commands.startup runs in the background, so that output only ever
# lands in /tmp/claudecodeui-dev.log, never this terminal. Poll for it:
# first boot has to wait out `npm install` + a native-module rebuild, and a
# sandbox that already had a user before this run never prints the line at
# all, which is expected, not an error.
#
# `npm run dev` runs both processes through `concurrently`, which prefixes
# every line with "[0] "/"[1] " — so the marker line actually lands as
# "[0] CLOUDCLI_ADMIN_PASSWORD=...", not at the start of the line. `grep -o`
# extracts just the "KEY=value" match itself regardless of what precedes
# it, so `cut`'s first "=" is always the marker's own, not part of a prefix.
admin_username=""
admin_password=""
if [ "${CCUI_SBX_NO_KIT:-0}" != "1" ]; then
  echo
  echo "  Waiting for first-time setup (installing dependencies)..."
  for _ in $(seq 1 30); do
    admin_password="$(sbx exec "$sbx_name" bash -lc 'grep -m1 -o "CLOUDCLI_ADMIN_PASSWORD=.*" /tmp/claudecodeui-dev.log 2>/dev/null | cut -d= -f2-' 2>/dev/null || true)"
    [ -n "$admin_password" ] && break
    sleep 2
  done
  if [ -n "$admin_password" ]; then
    admin_username="$(sbx exec "$sbx_name" bash -lc 'grep -m1 -o "CLOUDCLI_ADMIN_USERNAME=.*" /tmp/claudecodeui-dev.log 2>/dev/null | cut -d= -f2-' 2>/dev/null || true)"
  fi
fi

echo
if [ -n "$admin_password" ]; then
  echo "  Admin login:   ${admin_username:-admin} / $admin_password"
  copy_to_clipboard "$admin_password"
else
  echo "  (no auto-created admin found — sandbox may already have a user, or is still starting: sbx exec $sbx_name bash -lc 'tail -f /tmp/claudecodeui-dev.log')"
fi

echo
echo "  Attach to the claude agent:   sbx run --name $sbx_name"
echo "  Tail the dev server logs:    sbx exec $sbx_name bash -lc 'tail -f /tmp/claudecodeui-dev.log'"
echo "  Stop it:                     sbx stop $sbx_name"

# The server's own root redirects to the literal string "http://localhost:5173"
# (its own notion of "the client," which inside the sandbox is correct) — that
# never resolves on the host, so always open the Vite client URL, never the
# server/API one. CCUI_SBX_NO_OPEN=1 skips this.
#
# When we have a freshly auto-created admin password, pass it via
# ?username=&password= — LoginForm.tsx reads and prefills from these once on
# mount, then immediately scrubs them from the address bar/history, so the
# plaintext password sits in the URL only for this one local navigation.
# Also still copied to the clipboard above as a fallback for whatever opens
# the link next (e.g. pasting it into a different browser/profile).
if [ -n "$client_url" ]; then
  open_target="$client_url"
  if [ -n "$admin_password" ]; then
    open_target="$client_url/?username=$(urlencode "${admin_username:-admin}")&password=$(urlencode "$admin_password")"
  fi
  open_url "$open_target"
fi
